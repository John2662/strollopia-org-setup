__pycache__/
*.pyc
*.pyo
.env
.secrets.env
*.egg-info/
dist/
build/

# media/ dirs are pCloud symlinks (see README_symlink.md) — never commit real
# binaries here even if a symlink is temporarily replaced by real files
org-data/*/*/media/*

# real admin email/password for each org — see city_discover.py's
# write_org_setup and post_org_setup.py's load_org_config
org-data/*/org-setup.secrets.yaml

# generate_marketing_pdf.py embeds the org's plaintext admin email/password
# in this PDF by design, for physical hand-off to the customer — never commit
org-data/*/marketing.pdf

.worktrees/

# go_live_wizard.sh's KV-namespace step runs `npx wrangler` from this repo's
# root (not from strollopia-sites), which leaves wrangler's own account/
# cache files here
.wrangler/
